{
  "concepts": [
    {"id": "grammar", "kind": "domain", "words": ["grammar"],
     "attrs": {"what": "how words change shape and order to change meaning"}},
    {"id": "statement", "kind": "grammar_type", "words": ["statement", "declarative"],
     "attrs": {"example": "she walks", "does": "makes a claim"},
     "relations": [{"to": "grammar", "rel": "is-a"}]},
    {"id": "question", "kind": "grammar_type", "words": ["question", "interrogative"],
     "attrs": {"example": "does she walk?", "does": "asks"},
     "relations": [{"to": "grammar", "rel": "is-a"}, {"to": "statement", "rel": "pairs-with"}]},
    {"id": "command", "kind": "grammar_type", "words": ["command", "imperative"],
     "attrs": {"example": "walk!", "does": "tells someone to do it"},
     "relations": [{"to": "grammar", "rel": "is-a"}]},
    {"id": "exclamation", "kind": "grammar_type", "words": ["exclamation", "exclaim"],
     "attrs": {"example": "what a walk!", "does": "shouts a feeling"},
     "relations": [{"to": "grammar", "rel": "is-a"}, {"to": "statement", "rel": "pairs-with"}]},
    {"id": "negation", "kind": "grammar_type", "words": ["negation", "negative sentence"],
     "attrs": {"example": "she does not walk", "does": "flips the meaning"},
     "relations": [{"to": "grammar", "rel": "is-a"}, {"to": "statement", "rel": "opposite-of"}]},
    {"id": "active", "kind": "grammar_type", "words": ["active"],
     "attrs": {"example": "the dog chases the ball", "does": "actor acts first"},
     "relations": [{"to": "grammar", "rel": "is-a"}]},
    {"id": "passive", "kind": "grammar_type", "words": ["passive", "passive voice"],
     "attrs": {"example": "the ball is chased by the dog", "does": "swaps the actor and the target"},
     "relations": [{"to": "grammar", "rel": "is-a"}, {"to": "active", "rel": "flip-of"}]},
    {"id": "conditional", "kind": "grammar_type", "words": ["conditional"],
     "attrs": {"example": "if it rains, she stays in", "does": "makes one thing depend on another"},
     "relations": [{"to": "grammar", "rel": "is-a"}]},
    {"id": "comparative", "kind": "grammar_type", "words": ["comparative"],
     "attrs": {"example": "faster than", "does": "weighs two things"},
     "relations": [{"to": "grammar", "rel": "is-a"}]},
    {"id": "superlative", "kind": "grammar_type", "words": ["superlative"],
     "attrs": {"example": "the fastest", "does": "picks the top of all"},
     "relations": [{"to": "grammar", "rel": "is-a"}, {"to": "comparative", "rel": "pairs-with"}]},
    {"id": "relative_clause", "kind": "grammar_type", "words": ["relative clause"],
     "attrs": {"example": "the dog that barks", "does": "glues a describing sentence into a noun"},
     "relations": [{"to": "grammar", "rel": "is-a"}]},
    {"id": "past_tense", "kind": "grammar_type", "words": ["past tense", "past"],
     "attrs": {"example": "she walked", "does": "moves the action to before now",
               "rule": "mostly add -ed"},
     "relations": [{"to": "grammar", "rel": "is-a"}]},
    {"id": "present_tense", "kind": "grammar_type", "words": ["present tense", "present"],
     "attrs": {"example": "she walks", "does": "happens now"},
     "relations": [{"to": "grammar", "rel": "is-a"}, {"to": "past_tense", "rel": "pairs-with"}]},
    {"id": "future_tense", "kind": "grammar_type", "words": ["future tense", "future"],
     "attrs": {"example": "she will walk", "does": "moves the action to after now"},
     "relations": [{"to": "grammar", "rel": "is-a"}, {"to": "past_tense", "rel": "opposite-of"}]},
    {"id": "plural", "kind": "grammar_type", "words": ["plural"],
     "attrs": {"example": "cats", "does": "more than one", "rule": "mostly add -s"},
     "relations": [{"to": "grammar", "rel": "is-a"}]},
    {"id": "singular", "kind": "grammar_type", "words": ["singular"],
     "attrs": {"example": "cat", "does": "exactly one"},
     "relations": [{"to": "grammar", "rel": "is-a"}, {"to": "plural", "rel": "opposite-of"}]},

